  "legal": {
    "cgv": {
      "title": "TERMS",
      "highlight": "OF SALE",
      "disclaimer": "Generic draft to be reviewed by a legal professional before going live. Fill in the bracketed fields and adjust timelines to match your actual operations.",
      "sections": [
        {
          "h": "1. Purpose",
          "p": "These terms govern the sale of Dropix products (garments with a permanent, customizable QR code) ordered on dropix.dz, for customers located in Algeria."
        },
        {
          "h": "2. Price",
          "p": "Prices are shown in Algerian dinars (DZD), all taxes included, excluding shipping. Shipping fees vary by wilaya and are shown before the order is confirmed."
        },
        {
          "h": "3. Order and confirmation",
          "p": "Orders are placed without creating an account. After the cart is submitted, a Dropix team member calls the customer to confirm the order, delivery address, and total amount before production starts. A customer account (with a unique QR) is created automatically upon confirmation."
        },
        {
          "h": "4. Payment",
          "p": "Payment is made exclusively cash on delivery (COD), to the delivery person."
        },
        {
          "h": "5. QR code customization",
          "p": "Each item is customized with the style, color, and text chosen by the customer at order time. Once the order is confirmed by the Dropix team, the production sheet is frozen and can no longer be modified (see the Returns & Refunds page for error or defect cases)."
        },
        {
          "h": "6. Delivery",
          "p": "Delivery is available all over Algeria via a third-party carrier. Estimated timelines are communicated during the confirmation call and may vary by wilaya."
        },
        {
          "h": "7. Withdrawal and returns",
          "p": "See the dedicated Returns & Refunds page."
        },
        {
          "h": "8. Contact",
          "p": "For any order-related question: contact@dropix.dz"
        }
      ]
    },
    "retours": {
      "title": "RETURNS &",
      "highlight": "REFUNDS",
      "disclaimer": "Generic draft — adjust the timelines (7 days shown here as an example) and have it reviewed by a legal professional before going live.",
      "sections": [
        {
          "h": "Refusal at delivery",
          "p": "Since payment happens on delivery, the customer can refuse the package in front of the delivery person if the product has a visible defect or doesn't match the order. No payment is owed in that case."
        },
        {
          "h": "Customized products",
          "p": "Each item is made with the QR code, style and text specifically chosen by the customer: it is therefore a custom-made product. As is standard for this type of product, the item cannot be returned for a simple change of mind once production has started, except in case of a manufacturing defect."
        },
        {
          "h": "Manufacturing defect",
          "p": "In case of a proven defect (printing, flocking, non-working QR code), the customer has 7 days after receipt to contact Dropix at contact@dropix.dz with a photo of the defect and their order number. After review, Dropix offers a replacement or a refund."
        },
        {
          "h": "Refund terms",
          "p": "Since payment is made in cash on delivery, any approved refund is made by bank transfer or deposit under terms agreed with the customer during contact."
        },
        {
          "h": "Contact",
          "p": "contact@dropix.dz"
        }
      ]
    },
    "confidentialite": {
      "title": "PRIVACY",
      "highlight": "POLICY",
      "disclaimer": "Generic draft to be reviewed before going live, especially the company's legal name and data controller contact details.",
      "sections": [
        {
          "h": "Data collected",
          "p": "When ordering: name, phone, email, wilaya, commune and delivery address. After order confirmation: a customer account is created (Dropix ID, unique QR). When the QR code is used: scan statistics are recorded in aggregated, anonymized form (device and IP address fingerprint, never the raw IP)."
        },
        {
          "h": "Purpose",
          "p": "This data is only used to process the order, deliver the product, manage the customer account, and display QR scan statistics in the customer area."
        },
        {
          "h": "Sharing with third parties",
          "p": "Data is hosted by Supabase (database and authentication). Transactional emails (order confirmation, password reset) are sent via Resend. No data is sold to third parties."
        },
        {
          "h": "Retention",
          "p": "Data is kept as long as the customer account is active. A customer can request deactivation of their account and QR code at any time via their account area or by email."
        },
        {
          "h": "Your rights",
          "p": "You can view and edit your personal information from your account area (Settings), or write to contact@dropix.dz for any access, correction, or deletion request."
        },
        {
          "h": "Cookies",
          "p": "The site only uses technical cookies required for login and session (no advertising or third-party tracking cookies)."
        }
      ]
    },
    "mentions": {
      "title": "LEGAL",
      "highlight": "NOTICE",
      "disclaimer": "Draft to complete before going live: replace the bracketed fields with the company's real information (legal name, business registration number, tax ID, address), then have this text reviewed by an Algerian legal professional.",
      "sections": [
        {
          "h": "Site publisher",
          "p": "The Dropix site is published by [Legal name / sole proprietor], registered with the trade register under number [RC No.], tax ID [NIF No.], headquartered at [full address, wilaya], Algeria. Phone: [number] — Email: contact@dropix.dz"
        },
        {
          "h": "Publication director",
          "p": "[Name of publication director]"
        },
        {
          "h": "Hosting",
          "p": "The site is hosted by [host, e.g. Vercel Inc.] and data is stored by Supabase (database and authentication). Transactional emails are sent via Resend."
        },
        {
          "h": "Intellectual property",
          "p": "All site content (text, visuals, logo, QR preset designs) is the property of Dropix. Any reproduction without authorization is prohibited."
        },
        {
          "h": "Contact",
          "p": "For any question: contact@dropix.dz"
        }
      ]
    }
  },
